# Copy to .env (start.bat does this for you) and add keys with the ⚙ AI key button. Never share .env.
# Each provider keeps its own key, so you can switch between them without pasting again.
GROQ_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
CUSTOM_API_KEY=
# Images, voices and video clips (Google AI Studio key; set it in ⚙ AI key → Images, voices & video).
GEMINI_API_KEY=
# Optional: change these if Google renames the models.
# MEDIA_IMAGE_MODEL=gemini-nano-banana-2.1
# MEDIA_TTS_MODEL=gemini-3.8-flash-tts
# MEDIA_VIDEO_MODEL=gemini-omni-1.2-flash
# Which provider and model the bots use right now (set by the ⚙ AI key button).
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
# low | medium | high (gpt-oss and OpenAI reasoning models). Higher = smarter but slower and uses more of your limit.
AI_REASONING=low
PORT=4247
# Set to 1 to test the whole pipeline with fake answers (no key, no internet).
DRAMA_MOCK=0
